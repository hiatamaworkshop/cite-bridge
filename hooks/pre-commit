#!/bin/sh
# 引用ブリッジの整合の検査（cite-bridge）。何を監視するかは bridge/bridge.toml が決める（bridge.py precommit）。
# 使うリポジトリの .githooks/pre-commit にこのファイルを置き、有効にする:  git config core.hooksPath .githooks
# 道具の場所は環境変数 CITE_BRIDGE（bridge.py のパス）で替えられる。
# 無ければ既定の tools/cite-bridge/ を見て、そこにも無ければ前の既定の .claude/skills/cite-bridge/ を見る。
if [ -n "$CITE_BRIDGE" ]; then
  BRIDGE="$CITE_BRIDGE"
elif [ -f tools/cite-bridge/bridge.py ]; then
  BRIDGE=tools/cite-bridge/bridge.py
elif [ -f .claude/skills/cite-bridge/bridge.py ]; then
  BRIDGE=.claude/skills/cite-bridge/bridge.py
else
  BRIDGE=tools/cite-bridge/bridge.py
fi
if [ ! -f "$BRIDGE" ]; then
  echo "cite-bridge: $BRIDGE が無いので検査を飛ばした（CITE_BRIDGE で道具の場所を指す）" >&2
  exit 0
fi
exec python -I -X utf8 "$BRIDGE" precommit
